# =========================================================================
# MOHAMMAD BILAL — PORTFOLIO & CMS ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Supabase PostgreSQL & Auth Credentials
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Administrative Authentication
# Set these securely in your .env.local file or Vercel Environment Variables
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-super-strong-password-here

# 3. AI Recruiter FAQ Integration (Google Gemini API)
# Get a free key at https://aistudio.google.com
# If not provided, the portfolio seamlessly uses intelligent keyword FAQ fallback
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

